{
  "name": "huginn",
  "version": "0.2.1",
  "description": "One inbox for every channel you have to answer — self-hosted, with rule-based triage.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.1"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun src/index.ts",
    "desktop:sidecar": "bun build --compile --target=bun-darwin-arm64 src/index.ts --outfile desktop/src-tauri/binaries/huginn-server-aarch64-apple-darwin",
    "desktop:prepare": "bun run build && bun run desktop:sidecar",
    "desktop:dev": "cd desktop && tauri dev",
    "desktop:dev-data": "bun scripts/dev-data.ts",
    "desktop:build": "cd desktop && tauri build",
    "release": "bun scripts/release.ts",
    "vapid": "bun -e \"const k = require('web-push').generateVAPIDKeys(); console.log('HUGINN_VAPID_PUBLIC_KEY=' + k.publicKey + '\\nHUGINN_VAPID_PRIVATE_KEY=' + k.privateKey)\"",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint src web/src",
    "lint:fix": "eslint src web/src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"",
    "code:check": "bun run lint && bun run format:check && bun run type-check",
    "test": "bun test src web/src",
    "db:generate": "drizzle-kit generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@slack/web-api": "^7.13.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pino": "^10.3.1",
    "uqr": "^0.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-functional": "^9.0.2",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-unicorn": "^62.0.0",
    "husky": "^9.1.7",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  }
}
