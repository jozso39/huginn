# Copy to .env (mode 600). Everything else — connector tokens, OAuth refresh tokens —
# is entered in the UI and stored encrypted in the database with HUGINN_SECRET_KEY.

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing it means re-entering every connector token; it is not derivable from the DB.
HUGINN_SECRET_KEY=

# Key that external writers (a Hermes skill, a shell script) present as X-Huginn-Key
# on POST /api/items. Generate with: openssl rand -hex 24
HUGINN_INGEST_KEY=

# Where the SQLite file lives. The Docker image mounts ./data here.
HUGINN_DB_PATH=./data/huginn.db

# Where your browser reaches Huginn, e.g. https://huginn.my-tailnet.ts.net.
# Needed for "Sign in with Google" (the redirect back after sign-in).
# HUGINN_PUBLIC_URL=

# Optional: a relay page for OAuth redirects (docs/oauth-relay.html) on a domain your
# Google project trusts, for when Google will not redirect to HUGINN_PUBLIC_URL itself.
# HUGINN_OAUTH_RELAY_URL=

# Triage: sentence rules and guardrails (Jev) and the rule-learning agent, via
# OpenRouter. Optional — without it only condition rules run.
# HUGINN_OPENROUTER_API_KEY=
# HUGINN_JEV_MODEL=typesafe/jev-1.13
# HUGINN_FEEDBACK_MODEL=anthropic/claude-haiku-4.5

PORT=3000
LOG_LEVEL=info
