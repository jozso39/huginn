# For running the server yourself (`bun start`, `bun run dev`): development and tests.
# The Mac app needs none of this; it keeps its key and data in its own folder.
# Copy to .env (mode 600). Everything else — connector tokens, OAuth refresh tokens —
# is entered in the UI and stored encrypted in the database with HUGINN_SECRET_KEY.

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing it means re-entering every connector token; it is not derivable from the DB.
HUGINN_SECRET_KEY=

# Key that external writers (a shell script, another tool) present as X-Huginn-Key
# on POST /api/items. Generate with: openssl rand -hex 24
HUGINN_INGEST_KEY=

# Where the SQLite file lives.
HUGINN_DB_PATH=./data/huginn.db

# Where your browser reaches Huginn, e.g. http://localhost:3000.
# Needed for "Sign in with Google" (the redirect back after sign-in).
# HUGINN_PUBLIC_URL=

# Optional: a relay page for OAuth redirects (docs/oauth-relay.html) on a domain your
# Google project trusts, for when Google will not redirect to HUGINN_PUBLIC_URL itself.
# HUGINN_OAUTH_RELAY_URL=

# Triage: the key is set in Settings → AI Triage (OpenRouter or TypeSafe). These pin
# the models it is used with.
# HUGINN_JEV_MODEL=typesafe/jev-1.13
# HUGINN_TYPESAFE_JEV_MODEL=jev-1.13.0
# HUGINN_FEEDBACK_MODEL=anthropic/claude-haiku-4.5

# Signal: Huginn runs signal-cli itself (docs/signal.md) and finds it on PATH or in
# Homebrew's folders. Only for a signal-cli somewhere else:
# HUGINN_SIGNAL_CLI=/path/to/signal-cli

PORT=3000
LOG_LEVEL=info
